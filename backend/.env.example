# Development only. Replace CHANGE_ME with your local PostgreSQL password.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/helpdesk_db
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional for AI Help Center. Keep the real value only in this ignored .env file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
AUTH_SESSION_HOURS=8
